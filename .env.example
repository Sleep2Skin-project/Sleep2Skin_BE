# 로컬 개발 전용 설정. 이 파일을 복사해 .env 를 만든다.
#
#   cp .env.example .env
#
# .env 는 커밋하지 않는다 (.gitignore 등록됨).
#
# ─────────────────────────────────────────────────────────────
# ⚠️  DB_HOST 에 운영 RDS 주소를 넣지 않는다.
#
#   application.yml 이 ddl-auto: update 이므로, 앱이 뜨는 순간
#   작업 중인 엔티티가 그대로 운영 스키마에 반영된다.
#   update 는 컬럼을 추가만 하고 지우지 않으므로 되돌릴 수 없다.
#
#   로컬에서 스키마를 되돌릴 때 쓰는
#     docker compose down -v
#   는 RDS 에 대응하는 조치가 없다.
#
#   운영 값은 EC2 의 app.env 와 GitHub Secrets 에만 둔다.
#   운영 DB 를 봐야 하면 bastion/SSM 으로 그때 열고, 평소엔 닫아 둔다.
# ─────────────────────────────────────────────────────────────

# Docker Compose — 로컬 스택 파일을 가리킨다.
#   docker-compose.local.yml 은 자동 인식되는 이름이 아니라서 이 값이 필요하다.
#   이게 있어야 `docker compose up -d mysql` 이 -f 없이 동작한다.
COMPOSE_FILE=docker-compose.local.yml

# Database — 로컬 Docker MySQL (docker-compose.local.yml 의 mysql 서비스)
DB_HOST=localhost
DB_PORT=3307
DB_NAME=sleep2skin
DB_USERNAME=sleep2skin
DB_PASSWORD=changeme
DB_ROOT_PASSWORD=changeme

# OpenAI — 셀피 분석 (HOME-06)
#
#   비워 두어도 앱은 뜬다. 수면·예보·통역 카드는 전부 정상이고
#   POST /api/v1/skin/selfie 만 502 (SELFIE_ANALYSIS_FAILED) 로 실패한다.
#   기동 로그에 WARN 이 남으므로 조용히 넘어가지는 않는다.
#
#   ⚠️ 이 키는 실제 과금 대상이다. 커밋하지 않는다 (.env 는 .gitignore 등록됨).
#   ⚠️ 값에 따옴표를 붙이지 않는다.  OPENAI_API_KEY="sk-..." 로 적으면 따옴표까지 키가 된다.
OPENAI_API_KEY=

# 모델을 바꿀 때만 넣는다. 없으면 gpt-5.6-terra (docs/architecture.md §7)
# OPENAI_VISION_MODEL=gpt-5.6-luna
